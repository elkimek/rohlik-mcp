# Rohlik API credentials for testing (copy to .env and fill in)
ROHLIK_USERNAME=your-email@example.com
ROHLIK_PASSWORD=your-password

# Optional. Override the API base URL to point at a different Rohlik Group
# storefront (e.g. https://www.knuspr.de, https://www.gurkerl.at). Defaults
# to https://www.rohlik.cz.
# ROHLIK_BASE_URL=https://www.rohlik.cz

# Optional. Set to "true" to log auth + per-request debug info to stderr.
# ROHLIK_DEBUG=false
